<?xml version="1.0"?>

<robot name="air_jet">

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="../meshes/blower.stl"
                    scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="../meshes/blower.stl"
                    scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <inertia
                ixx="0.01"
                iyy="0.01"
                izz="0.01"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>

    </link>

</robot>