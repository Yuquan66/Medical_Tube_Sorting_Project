<?xml version="1.0"?>
<robot name="polypropylene-centrifuge-tube-1">

  <link name="centrifuge-pp-1-base">
    <visual>
      <geometry>
        <mesh filename="../../meshes/polypropene-centrifugal-base-1.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../meshes/polypropene-centrifugal-base-1.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <contact>
      <lateral_friction value="0.35"/>
      <rolling_friction value="0.002"/>
      <spinning_friction value="0.002"/>
      <restitution value="0.05"/>
    </contact>
  </link>

  <link name="centrifuge-pp-1-cap">
    <visual>
      <geometry>
        <mesh filename="../../meshes/red-cap.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../meshes/red-cap.obj" scale="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <contact>
      <lateral_friction value="0.30"/>
      <rolling_friction value="0.002"/>
      <spinning_friction value="0.002"/>
      <restitution value="0.05"/>
    </contact>
  </link>
  <joint name="base_to_cap" type="revolute">
    <parent link="centrifuge-pp-1-base"/>
    <child link="centrifuge-pp-1-cap"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-31.4" upper="31.4" effort="10" velocity="5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

</robot>
